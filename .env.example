# Copy to .env. Never commit .env.
# At least one provider key is required or the service refuses to start.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Ollama needs no key; setting this URL is what enables the local provider.
# 127.0.0.1, not localhost: on macOS localhost prefers IPv6 and may reach a
# different Ollama instance with a different set of models.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://gateway:gateway@localhost:5433/gateway
CONFIG_PATH=gateway.yaml

# Observability. Without a token spans print to stdout, so local dev is still traced.
LOGFIRE_TOKEN=
SERVICE_NAME=llm-gateway
ENVIRONMENT=dev

# Output tokens reserved at admission, reconciled against the real count after.
ESTIMATED_OUTPUT_TOKENS=500
